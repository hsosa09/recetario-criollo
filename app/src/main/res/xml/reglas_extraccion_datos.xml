<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Mismo criterio que reglas_backup.xml, tanto para el backup en
     la nube como para el pase directo de telefono a telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cronometros.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cronometros.xml" />
    </device-transfer>
</data-extraction-rules>
