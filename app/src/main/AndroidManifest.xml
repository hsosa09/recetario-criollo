<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Avisar cuando termina un cronometro de cocina -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notas de voz del historial: se piden al tocar «Nota de voz» y el audio no sale del teléfono -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Que el timer suene en el segundo justo. Desde Android 13 arranca denegado y se pide
         desde la pantalla de Timers; sin el, la alarma se programa inexacta.
         No se usa USE_EXACT_ALARM: Play lo reserva para despertadores y calendarios. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Reprogramar los timers en marcha despues de reiniciar el telefono -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RecetarioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/reglas_extraccion_datos"
        android:fullBackupContent="@xml/reglas_backup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecetarioCriollo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RecetarioCriollo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La app de cámara escribe la foto del resultado en un archivo propio -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>

        <!-- Widget de timers: lo instancia el launcher, por eso va exportado -->
        <receiver
            android:name=".widget.ReceptorWidgetTimers"
            android:exported="true"
            android:label="@string/widget_timers_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timers" />
        </receiver>

        <receiver
            android:name=".cronometro.ReceptorFinCronometro"
            android:exported="false" />

        <receiver
            android:name=".cronometro.ReceptorArranque"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
